    <plot x="1585" autoPlotX="true" yMax="10.0" autoPlotY="true" y="480" xMin="0.0" height="285" legend="false" xMax="10.0" yMin="0.0" width="290" display="Shape factor">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="sf" color="-7500403" legend="true">
        <setup></setup>
        <update></update>
      </pen>
    </plot>
