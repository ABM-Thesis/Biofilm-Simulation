<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; BIOFILM FORMATION AND ANTIBIOTIC MODEL (NetLogo)
;;
;; Agent-based simulation of bacterial biofilm growth under antibiotic
;; pressure: antibiotic diffusion and decay, nutrient gradient, mutation-
;; driven resistance, horizontal gene transfer (HGT) through the EPS,
;; sub-lethal (MIC) growth inhibition and lethal (MBC) killing, fitness
;; cost of resistance, persister (dormant) cells, volume exclusion and
;; structural metrics of the biofilm.
;;
;; Diploma Thesis - Athanasios Nakos & Vasileios Galanis
;; Supervisor: Aspasia Daskalopoulou
;; Dept. of Electrical & Computer Engineering, University of Thessaly, 2026
;;
;; Design notes:
;;  * Antibiotic in [MIC, MBC] inhibits growth (bacteriostatic); above MBC it
;;    kills probabilistically (bactericidal).
;;  * The per-cell thresholds mic/mbc are derived from `resistance` in ONE
;;    place (update-thresholds), called at birth, after mutation and after HGT,
;;    so the three values never fall out of sync.
;;  * Mortality is applied before division: a cell killed in the current tick
;;    cannot divide in the same tick. The quorum check runs once per tick.
;;  * Dead cells stay on the grid (gray); `dead` is a CUMULATIVE count.
;;  * user-message dialogs are behind the `verbose?` switch so the model can
;;    run headless in BehaviorSpace.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

globals [
  time-step
  shape-factor          ;; simple smoothed max-height metric (used only by the "Shape factor" plot)
  shape-history         ;; moving window of the last thickness values
  mutation-count
  hgt-count             ;; number of successful HGT uptake events (direct measurement)
  biofilm-formation?
  ;; ---- structural metrics of the biofilm ----------------------------------
  ;; Each metric is >= 0 and referenced to the physical floor (min-pycor).
  ;; When no live cell exists they are set to -999, a NaN sentinel that the
  ;; analysis script filters out, so that extinction is never confused with
  ;; a real structural measurement.
  bf-height             ;; 95th percentile of cell height above the floor
  bf-spread             ;; SD of cell height (vertical spread of the colony)
  bf-occupancy          ;; live cells per occupied patch (packing density)
]

patches-own [
  nutrient
  antibiotic
  resistancegenesateps  ;; EPS-bound resistance genes available for HGT
]

turtles-own [
  energy
  resistance
  mbc                   ;; Minimum Bactericidal Concentration (lethal threshold) for THIS cell
  mic                   ;; Minimum Inhibitory Concentration (sub-lethal threshold) for THIS cell
  alive?
  dormant?              ;; persister phenotype: no growth, reduced upkeep, drug-tolerant
]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SETUP
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup
  clear-all
  set-default-shape turtles "circle"
  set biofilm-formation? false

  ;; environment initialization
  ask patches [
    set nutrient random-float nutrientdensity
    set antibiotic 0
    set resistancegenesateps 0
    set pcolor scale-color green nutrient 0 1
  ]

  ;; initial bacteria at the bottom
  create-turtles initial-number-bacteria [
    setxy random-xcor (min-pycor + random spawncellposition)
    set color blue
    set energy random-float 1.0
    set resistance random-float 0.5
    update-thresholds            ;; sets mbc and mic from resistance
    set alive? true
    set dormant? false
  ]

  set shape-history []
  set shape-factor 0
  set mutation-count 0
  set hgt-count 0
  set bf-height 0
  set bf-spread 0
  set bf-occupancy 0
  set time-step 0

  reset-ticks
end

;; --- single source of per-cell thresholds ------------------
;; Called at birth, after mutation, and after HGT so `resistance`, `mbc` and
;; `mic` can never fall out of sync.
to update-thresholds      ;; turtle procedure
  set mbc (0.2 + resistance * 0.5)      ;; range [0.2, 0.7]
  set mic (mbc / mbc-mic-ratio)         ;; MIC < MBC (ratio is a slider, default 2)
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; MAIN LOOP
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to go
  if not any? turtles with [alive?] [
    stop
  ]

  diffuse-antibiotic
  bacteria-behave
  update-environment
  diffuse-resistancegenesateps
  compute-shape-factor
  update-myplots
  log-data

  set time-step time-step + 1
  tick
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ANTIBIOTIC DIFFUSION
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to diffuse-antibiotic
  ;; STRONG-PENETRATION scenario (switch): floods the drug deeper so it reaches the
  ;; biofilm base and can act on the cells. When off, the interface sliders (baseline)
  ;; are used and the drug stays near the top (spatial refuge).
  let below-band ifelse-value strong-penetration? [8]     [antibioticapplication-belowtop]
  let dif        ifelse-value strong-penetration? [0.9]   [antibiotic-diffusion]
  let dec        ifelse-value strong-penetration? [0.999] [antibiotic-decay]

  ;; antibiotic source from the top boundary (band of thickness below-band)
  ask patches with [pycor > max-pycor - below-band] [
    set antibiotic source-concentration
  ]

  ;; partial diffusion
  diffuse antibiotic dif

  ;; natural decay (values < 1.0 actually remove drug; 1.0 = no decay)
  ask patches [
    set antibiotic antibiotic * dec
  ]

  ;; ---- WELL-MIXED CONTROL (dose-matched) -------------------------------
  ;; Every patch is held at wellmixed-level, which must be set to the MEAN
  ;; concentration measured in the corresponding gradient run. The cells are
  ;; then exposed to the same average dose but with no spatial gradient, so any
  ;; difference is attributable to spatial structure alone.

  if well-mixed? [
    ask patches [ set antibiotic wellmixed-level ]
  ]
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; BACTERIA BEHAVIOR
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to bacteria-behave
  ;; quorum sensing is a population-level state -> evaluate ONCE per tick
  if (not biofilm-formation?) and (count turtles with [alive?] >= quorum-threshold) [
    set biofilm-formation? true
    if verbose? [
      user-message (word "Biofilm Formation Achieved!\n\n"
        "Quorum Sensing triggered at tick " ticks ".\n"
        "Live bacteria: " count turtles with [alive?])
    ]
  ]

  ask turtles with [alive?] [

    ;; ---- persistence / dormancy (phenotypic tolerance) ------------------
    ;; A fraction of cells stochastically switches into a dormant (persister)
    ;; state: no growth, no division, reduced upkeep and phenotypic tolerance
    ;; to the antibiotic. With persister-switch-prob = 0 this is inactive.
    ifelse dormant?
      [ if random-float 1.0 < persister-wake-prob   [ set dormant? false ] ]
      [ if random-float 1.0 < persister-switch-prob [ set dormant? true  ] ]

    ;; bacteria movement
    left random 45
    right random 45
    forward random 0.05

    let local-antibiotic [antibiotic] of patch-here

    ;; ---- sub-lethal (bacteriostatic) effect in [MIC, MBC] ----------------
    ;; growth-factor = 1 below MIC, ramps linearly to 0 as antibiotic -> MBC
    let growth-factor 1
    if local-antibiotic > mic [
      ifelse local-antibiotic >= mbc
        [ set growth-factor 0 ]
        [ set growth-factor 1 - ((local-antibiotic - mic) / (mbc - mic)) ]
    ]

    ;; ---- fitness cost of resistance -------------------------------------
    ;; Resistance is not free: nutrient uptake is reduced in proportion to the
    ;; resistance level. With resistance-cost = 0 resistance is cost-free 
    let cost-factor (1 - resistance-cost * resistance)
    if cost-factor < 0 [ set cost-factor 0 ]

    ;; nutrient uptake (scaled by growth-factor and cost; dormant cells do not feed)
    if not dormant? [
      let local-nutrient [nutrient] of patch-here
      set energy energy + local-nutrient * 0.2 * growth-factor * cost-factor
      ask patch-here [ set nutrient nutrient * 0.9 ]
    ]

    ;; ---- Horizontal Gene Transfer ---------------------------------------
    ;; deposit resistance genes into the EPS (only inside a formed biofilm)
    if biofilm-formation? and hgt-enabled? and (resistance >= triggerhgt) [
      set resistancegenesateps max (list resistancegenesateps resistance)
    ]
    ;; take up EPS resistance genes if they exceed own resistance.
    ;; Uptake is stochastic: hgt-transfer-prob = 1 gives deterministic
    ;; uptake, lower values turn transfer into a rate.
    if (resistancegenesateps > resistance) and (random-float 1.0 < hgt-transfer-prob) [
      set resistance resistancegenesateps
      update-thresholds        ;; acquired resistance raises the survival thresholds
      set hgt-count hgt-count + 1   ;; HGT is measured directly, not inferred
    ]

    ;; ---- lethal (bactericidal) effect above MBC -------------------------
    ;; dormant persisters are phenotypically tolerant and are not killed
    if (not dormant?) and local-antibiotic > mbc [
      if random-float 1.0 < (local-antibiotic / mbc) * 0.2 [
        set alive? false
        set color gray
      ]
    ]

    ;; cellular division (a cell killed just above, or dormant, cannot divide)
    ;; NOTE: reproduce halves the parent's energy only if a division really happens
    if alive? and (not dormant?) and energy > reproduction-energy-threshold [
      reproduce
    ]

    ;; cellular metabolism (maintenance cost, reduced while dormant)
    ifelse dormant?
      [ set energy energy - metabolic-rate * 0.25 ]
      [ set energy energy - metabolic-rate ]
    if energy < 0 [
      set alive? false
      set color gray
    ]
  ]

  if (count turtles with [alive?] = 0) and verbose? [
    user-message (word "All bacteria have died!\n\nSimulation ended after " ticks " ticks.")
  ]
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; REPRODUCTION WITH MUTATION
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to reproduce
  ;; ---- volume exclusion -------------------------------------------------
  ;; max-cells-per-patch = 0 disables the mechanism (no crowding limit).
  ;; With a positive limit a cell can divide only if there is free space in its
  ;; own patch or its Moore neighbourhood. Because the patches next to the
  ;; nutrient-rich substrate fill up first, the colony is pushed upward: the
  ;; vertical structure emerges from crowding instead of being imposed.
  let birth-patch nobody
  if max-cells-per-patch > 0 [
    let free-spots (patch-set patch-here neighbors) with [count turtles-here < max-cells-per-patch]
    if not any? free-spots [ stop ]     ;; crowded: growth arrest, energy is retained
    set birth-patch one-of free-spots
  ]

  hatch 1 [
    ifelse birth-patch = nobody
      [ rt random 60 - random 60
        fd 1 ]
      [ move-to birth-patch ]
    set energy 0.5
    set dormant? false

    ;; mutation on division
    if random-float 1.0 < mutation-chance [
      set resistance resistance + random-normal 0 0.05
      set resistance max (list 0 (min (list 1 resistance)))
      update-thresholds        ;; keep mbc/mic in sync with the mutated resistance
      set mutation-count mutation-count + 1
    ]
    set color yellow + 10 * resistance   ;; subsequent generations: hue by resistance
  ]

  set energy energy / 2      ;; the parent pays only for a division that happened
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; HORIZONTAL GENE TRANSFER (EPS gene diffusion + decay)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to diffuse-resistancegenesateps
  diffuse resistancegenesateps resistancegenesateps-diffuse-rate
  ask patches [
    set resistancegenesateps resistancegenesateps * resistancegenesateps-natural-decay
  ]
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ENVIRONMENT UPDATE
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to update-environment
  ;; nutrient influx from the bottom substrate band
  ask patches with [pycor < min-pycor + 2 + idealenvironemt-abovesubstrate] [
    set nutrient 1.0
  ]

  ;; ---- nutrient diffusion from the substrate ---------------------------

  if nutrient-diffusion > 0 [
    diffuse nutrient nutrient-diffusion
    ask patches with [pycor < min-pycor + 2 + idealenvironemt-abovesubstrate] [
      set nutrient 1.0
    ]
  ]

  ;; patch coloring: red = antibiotic zone, green = nutrient level
  ask patches [
    ifelse antibiotic > 0.5
      [ set pcolor scale-color red antibiotic 0 1 ]
      [ set pcolor scale-color green nutrient 0 1 ]
  ]
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; STRUCTURAL METRICS OF THE BIOFILM
;; bf-height, bf-spread, bf-occupancy (reported to BehaviorSpace) and the
;; simple smoothed shape-factor (plot only).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to compute-shape-factor
  let live-bacteria turtles with [alive?]

  ;; ---- no live cells: emit the NaN sentinel, do NOT freeze the last value --
  ;; Extinct runs have no structure.
  ifelse not any? live-bacteria [
    set bf-height    -999
    set bf-spread    -999
    set bf-occupancy -999
  ] [
    ;; --- (1) height: 95th percentile above the physical floor -------------
    ;; Robust to a single stray cell that would dominate a max-based value.
    let heights sort [pycor - min-pycor] of live-bacteria
    let n length heights
    let idx floor (0.95 * (n - 1))
    set bf-height item idx heights

    ;; --- (2) vertical spread: SD of cell height ---------------------------
    ;; A flat monolayer on the substrate gives ~0; a colony spread through the
    ;; depth of the world gives a large value. This is deliberately a spread
    ;; measure over cells, NOT a surface-roughness measure: surface roughness
    ;; requires a per-column maximum, which is reported as a limitation.
    ifelse count live-bacteria > 1
      [ set bf-spread standard-deviation [pycor - min-pycor] of live-bacteria ]
      [ set bf-spread 0 ]

    ;; --- (3) occupancy: live cells per occupied patch ---------------------
    let occ count patches with [any? turtles-here with [alive?]]
    ifelse occ > 0
      [ set bf-occupancy (count live-bacteria) / occ ]
      [ set bf-occupancy 0 ]

    ;; --- simple metric: smoothed max height (for the "Shape factor" plot) --
    let substrate (min-pycor + 2)
    let bf-thickness (max [pycor] of live-bacteria) - substrate
    set shape-history lput bf-thickness shape-history
    if length shape-history > 20 [ set shape-history but-first shape-history ]
    set shape-factor mean shape-history
  ]
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PLOTS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to update-myplots
  let live-bacteria turtles with [alive?]

  set-current-plot "Population"
  set-current-plot-pen "Live"
  plot count live-bacteria
  set-current-plot-pen "Dead"
  plot count turtles with [not alive?]

  set-current-plot "Mutation Count"
  plot mutation-count

  set-current-plot "Mean resistance"
  set-current-plot-pen "mean-res"
  ifelse any? live-bacteria
    [ plot mean [resistance] of live-bacteria ]
    [ plot 0 ]

  ;; environmental antibiotic (mean over all patches)
  set-current-plot "Environmental Antibiotic"
  set-current-plot-pen "env-antibiotic"
  plot mean [antibiotic] of patches

  set-current-plot "Shape factor"
  set-current-plot-pen "sf"
  plot shape-factor
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; DATA LOGGING (for interactive single runs)
;; NOTE: for BehaviorSpace, use its own table output instead of this file.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to log-data
  if not file-exists? "biofilm-data.csv" [
    file-open "biofilm-data.csv"
    file-print "ticks,live,dead,mean-env-antibiotic,mean-mbc,mean-resistance,shape-factor,mutations"
    file-close
  ]

  let live-bacteria turtles with [alive?]
  let live-count count live-bacteria
  let dead-count count turtles with [not alive?]

  let mean-env-antibiotic mean [antibiotic] of patches   ;; mean antibiotic in the world
  let mean-mbc 0
  let mean-res 0
  if any? live-bacteria [
    set mean-mbc mean [mbc] of live-bacteria
    set mean-res mean [resistance] of live-bacteria
  ]

  file-open "biofilm-data.csv"
  file-print (word ticks "," live-count "," dead-count "," mean-env-antibiotic ","
    mean-mbc "," mean-res "," shape-factor "," mutation-count)
  file-close
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; REPORTERS FOR BEHAVIORSPACE
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Fraction of the live population that is resistant (resistance > 0.5).
;; Reported instead of relying on the MEAN resistance alone: when the outcome
;; is effectively bimodal (fixation vs no fixation) the mean of a handful of
;; runs is not interpretable, whereas the fraction is.
to-report frac-resistant
  let live-bacteria turtles with [alive?]
  ifelse any? live-bacteria
    [ report (count live-bacteria with [resistance > 0.5]) / (count live-bacteria) ]
    [ report -999 ]
end

;; Mean resistance, NaN-sentinelled on extinction: reporting 0 for an
;; extinct run would be indistinguishable from a surviving but fully
;; susceptible population.
to-report mean-resistance-safe
  let live-bacteria turtles with [alive?]
  ifelse any? live-bacteria
    [ report mean [resistance] of live-bacteria ]
    [ report -999 ]
end
]]></code>
  <widgets>
    <view x="495" wrappingAllowedX="false" y="65" frameRate="30.0" minPycor="-16" height="749" showTickCounter="true" patchSize="22.6" fontSize="10" wrappingAllowedY="false" width="749" tickCounterLabel="ticks" maxPycor="16" updateMode="1" maxPxcor="16" minPxcor="-16"></view>
    <button x="1710" y="245" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55" display="setup">setup</button>
    <slider x="1255" step="0.01" y="335" max="1" width="250" display="mutation-chance" height="50" min="0" direction="Horizontal" default="0.02" variable="mutation-chance"></slider>
    <slider x="1255" step="0.1" y="285" max="15" width="250" display="reproduction-energy-threshold" height="50" min="0" direction="Horizontal" default="2.5" variable="reproduction-energy-threshold"></slider>
