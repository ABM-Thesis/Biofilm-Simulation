  <linkShapes>
    <shape name="default" curviness="0.0">
      <lines>
        <line x="-0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
        <line x="0.0" visible="true">
          <dash value="1.0"></dash>
          <dash value="0.0"></dash>
        </line>
        <line x="0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
      </lines>
      <indicator>
        <shape name="link direction" rotatable="true" editableColorIndex="0">
          <line endX="90" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
          <line endX="210" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
        </shape>
      </indicator>
    </shape>
  </linkShapes>
  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="1-baseline-replicates" repetitions="20" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="2000">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>count turtles with [alive?]</metric>
        <metric>count turtles with [not alive?]</metric>
        <metric>ifelse-value any? turtles with [alive?] [mean [resistance] of turtles with [alive?]] [0]</metric>
        <metric>mean [antibiotic] of patches</metric>
        <metric><![CDATA[mean [antibiotic] of patches with [pycor < min-pycor + 4]]]></metric>
        <metric>shape-factor</metric>
        <metric>mutation-count</metric>
        <metric>count turtles with [alive? and dormant?]</metric>
        <metric>ifelse-value any? turtles with [alive?] [mean [pycor] of turtles with [alive?]] [0]</metric>
        <metric><![CDATA[mean [antibiotic] of patches with [pycor < min-pycor + 8]]]></metric>
        <metric><![CDATA[mean [antibiotic] of patches with [pycor >= min-pycor + 8 and pycor < min-pycor + 16]]]></metric>
        <metric><![CDATA[mean [antibiotic] of patches with [pycor >= min-pycor + 16 and pycor < min-pycor + 24]]]></metric>
        <metric><![CDATA[mean [antibiotic] of patches with [pycor >= min-pycor + 24]]]></metric>
        <metric><![CDATA[mean [nutrient] of patches with [pycor < min-pycor + 8]]]></metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="verbose?">
          <value value="false"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="initial-number-bacteria">
          <value value="20"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="spawncellposition">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="nutrientdensity">
          <value value="0.9"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="idealenvironemt-abovesubstrate">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="quorum-threshold">
          <value value="60"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reproduction-energy-threshold">
          <value value="2.5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="metabolic-rate">
          <value value="0.02"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="mutation-chance">
          <value value="0.02"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="mbc-mic-ratio">
          <value value="2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="antibiotic-diffusion">
          <value value="0.2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="antibioticapplication-belowtop">
          <value value="2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="antibiotic-decay">
          <value value="0.95"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="Triggerhgt">
          <value value="0.5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="resistancegenesateps-diffuse-rate">
          <value value="0.2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="resistancegenesateps-natural-decay">
          <value value="0.9"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="hgt-enabled?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="strong-penetration?">
          <value value="false"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="well-mixed?">
          <value value="false"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="resistance-cost">
          <value value="0"></value>
